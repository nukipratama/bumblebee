# Slack bot token (xoxb-...) — from OAuth & Permissions, scopes: chat:write, commands
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token (xapp-...) — from Basic Information, scope: connections:write (Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# SQLite database path (default: ./data/bumblebee.db). In prod this resolves to
# the mounted /app/data volume — no need to set it there.
# DB_PATH=./data/bumblebee.db
