# Slack bot token (xoxb-...) — from OAuth & Permissions, scopes: chat:write, app_mentions:read, commands
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token (xapp-...) — from Basic Information, scope: connections:write (Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- Azure OpenAI ---
# Resource endpoint, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# API key from the Azure OpenAI resource (Keys and Endpoint)
AZURE_OPENAI_API_KEY=your-azure-openai-key
# The deployment name you created for a chat model (not the base model name)
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# API version (default: 2024-10-21)
AZURE_OPENAI_API_VERSION=2024-10-21
