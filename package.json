{
  "name": "bumblebee",
  "version": "0.1.0",
  "description": "LIMO team's general-purpose Slack bot — successor to Optimus.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "TZ=Asia/Jakarta tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=80 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/bolt": "^5.0.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@slack/types": "^3.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
